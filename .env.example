# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. .env.local은 저장소에 올라가지 않아요.
# 비워 두면 로그인 없이 데모 마을(브라우저 저장)로 실행돼요.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google AI Studio → API key (서버에서만 쓰임. 비워 두면 AI 초안 대신 기본 템플릿)
GEMINI_API_KEY=
# 선택: 바꾸고 싶을 때만
GEMINI_MODEL=gemini-3.8-flash
