# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. .env.local은 저장소에 올라가지 않아요.
# 비워 두면 로그인 없이 데모 마을(브라우저 저장)로 실행돼요.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google AI Studio → API key (서버에서만 쓰임. 비워 두면 AI 초안 대신 기본 템플릿)
GEMINI_API_KEY=
# 선택: 바꾸고 싶을 때만
GEMINI_MODEL=gemini-3.8-flash

# 선택: 땅 넓히기 보상형 광고(Google Ad Manager → 광고 단위 → 웹 보상형). 예: /12345678/sidetown_rewarded
# 비워 두면 앱 안 테스트 광고(16초)로 같은 흐름이 동작해요.
NEXT_PUBLIC_GAM_REWARDED_AD_UNIT=
