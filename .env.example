# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. .env.local은 저장소에 올라가지 않아요.
# 비워 두면 로그인 없이 데모 마을(브라우저 저장)로 실행돼요.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google AI Studio → API key (서버에서만 쓰임. 비워 두면 AI 초안 대신 기본 템플릿)
GEMINI_API_KEY=
# 선택: 바꾸고 싶을 때만
GEMINI_MODEL=gemini-3.8-flash

# 선택: AdSense 게시자 ID(AdSense → 계정 → 계정 정보의 ‘게시자 ID’에 ca-pub-를 붙인 값). 예: ca-pub-1234567890123456
# 넣으면 <head>에 AdSense 코드가 들어가고 /ads.txt가 만들어져요. 광고 종류·위치는 AdSense ‘자동 광고’ 설정에서 정해요.
NEXT_PUBLIC_ADSENSE_CLIENT=
